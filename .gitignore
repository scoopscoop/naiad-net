ui/node_modules/
ui/dist/
ui/build/
ui/.svelte-kit/
ui/.next/
ui/out/

# Tauri
ui/src-tauri/target/
# Tauri-staged sidecar (regenerated by ui/src-tauri/build.rs on every build)
ui/src-tauri/binaries/
# Release artifacts
dist/

